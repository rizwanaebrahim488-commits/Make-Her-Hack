# ReLoop Environment Variables (Template)
# Copy this file to .env and fill in your values
# NOTE: Never commit your actual .env file with real credentials to GitHub.

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public / Anon API Key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
